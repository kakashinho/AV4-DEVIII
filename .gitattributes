# Normaliza line endings automaticamente para arquivos de texto
* text=auto eol=lf

# Scripts shell SEMPRE com LF (essencial para rodar em Linux/macOS)
*.sh        text eol=lf
mvnw        text eol=lf
gradlew     text eol=lf

# Scripts Windows SEMPRE com CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Arquivos binários
*.jar       binary
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
