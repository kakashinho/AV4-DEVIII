@baseUrl = http://localhost:8080/api

# =========================================================
# USUÁRIOS - CRUD COM ENDEREÇO COMPLETO
# =========================================================

# CRIAR USUÁRIO (COM ENDEREÇO COMPLETO - OK)
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
  "nome": "Carlos Eduardo",
  "nomeSocial": "Carlos",
  "perfis": ["CLIENTE", "FUNCIONARIO"],
  "endereco": {
    "estado": "SP",
    "cidade": "São José dos Campos",
    "bairro": "Jardim Aquarius",
    "rua": "Rua das Palmeiras",
    "numero": "1234",
    "codigoPostal": "12246-000",
    "informacoesAdicionais": "Apartamento 101, bloco B"
  }
}

###

# CRIAR USUÁRIO 2 (ENDEREÇO DIFERENTE - OK)
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
  "nome": "Mariana Souza",
  "nomeSocial": "Mari",
  "perfis": ["CLIENTE"],
  "endereco": {
    "estado": "SP",
    "cidade": "Campinas",
    "bairro": "Centro",
    "rua": "Avenida Brasil",
    "numero": "500",
    "codigoPostal": "13010-000",
    "informacoesAdicionais": "Sala comercial 12"
  }
}

###

# =========================================================
# ATUALIZAÇÃO PARCIAL DE ENDEREÇO
# =========================================================

# Atualiza usuário mantendo endereço existente (sem enviar endereco)
PUT {{baseUrl}}/usuarios/1
Content-Type: application/json

{
  "nome": "Carlos Atualizado",
  "nomeSocial": "Carlão",
  "perfis": ["CLIENTE"]
}

###

# =========================================================
# ATUALIZAÇÃO COMPLETA DE ENDEREÇO
# =========================================================

# Atualiza endereço inteiro (substituição completa)
PUT {{baseUrl}}/usuarios/1
Content-Type: application/json

{
  "nome": "Carlos Atualizado 2",
  "nomeSocial": "Carlos E.",
  "perfis": ["CLIENTE", "FUNCIONARIO"],
  "endereco": {
    "estado": "RJ",
    "cidade": "Rio de Janeiro",
    "bairro": "Copacabana",
    "rua": "Rua Atlântica",
    "numero": "987",
    "codigoPostal": "22070-001",
    "informacoesAdicionais": "Vista mar"
  }
}

###

# =========================================================
# TESTE DE VALIDAÇÃO - ENDEREÇO INCOMPLETO
# =========================================================

# Faltando campos obrigatórios (deve falhar)
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
  "nome": "Usuário Inválido",
  "perfis": ["CLIENTE"],
  "endereco": {
    "estado": "SP",
    "cidade": "São Paulo"
  }
}

###

# =========================================================
# CONSULTA PARA VALIDAR ENDEREÇO (HATEOAS)
# =========================================================

# Ver usuário com endereço completo
GET {{baseUrl}}/usuarios/1

###

# Ver usuário 2
GET {{baseUrl}}/usuarios/2

###

# =========================================================
# ASSOCIAÇÕES (COM USUÁRIOS COM ENDEREÇO COMPLETO)
# =========================================================

# EMAIL no usuário com endereço completo
POST {{baseUrl}}/usuarios/1/emails
Content-Type: application/json

{
  "emailId": 1
}

###

# DOCUMENTO no usuário 1
POST {{baseUrl}}/usuarios/2/documentos
Content-Type: application/json

{
  "documentoId": 1
}

###

# TELEFONE no usuário 1
POST {{baseUrl}}/usuarios/1/telefones
Content-Type: application/json

{
  "telefoneId": 1
}

###

# CREDENCIAL no usuário 1
POST {{baseUrl}}/usuarios/1/credenciais
Content-Type: application/json

{
  "credencialId": 1
}

###

# =========================================================
# STRESS TEST FINAL - USUÁRIO COMPLETO
# =========================================================

# Usuário 1 com tudo associado + endereço completo
GET {{baseUrl}}/usuarios/1

###

# Usuário 2 também completo
GET {{baseUrl}}/usuarios/2

###