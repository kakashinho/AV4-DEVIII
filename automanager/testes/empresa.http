{}


###

# REMOVER SERVICO DA EMPRESA (204) — substitua pelo id retornado no POST
DELETE {{baseUrl}}/empresas/1/servicos/4

###

# REMOVER SERVICO INEXISTENTE (404)
DELETE {{baseUrl}}/empresas/1/servicos/999999

###

# REMOVER SERVICO DE OUTRA EMPRESA (404)
DELETE {{baseUrl}}/empresas/2/servicos/1

###


# =========================
# SUB-RECURSO: VENDAS
# =========================

# LISTAR VENDAS DA EMPRESA OK
GET {{baseUrl}}/empresas/1/vendas

###

# LISTAR VENDAS DE EMPRESA INEXISTENTE (404)
GET {{baseUrl}}/empresas/999999/vendas

###

# OBTER VENDA ESPECIFICA DA EMPRESA (200)
GET {{baseUrl}}/empresas/1/vendas/1

###

# OBTER VENDA QUE NAO PERTENCE A EMPRESA (404)
GET {{baseUrl}}/empresas/1/vendas/999999

###

# OBTER VENDA DE EMPRESA INEXISTENTE (404)
GET {{baseUrl}}/empresas/999999/vendas/1

###

# CRIAR VENDA NO CONTEXTO DA EMPRESA (201)
POST {{baseUrl}}/empresas/1/vendas
Content-Type: application/json

{
  "identificacao": "VENDA-EMPRESA-001",
  "clienteId": 3,
  "funcionarioId": 1,
  "veiculoId": 1,
  "itens": [
    { "mercadoriaId": 2, "quantidade": 1 }
  ],
  "servicos": [
    { "servicoId": 1 }
  ]
}

###

# CRIAR VENDA SÓ COM SERVIÇO (201)
POST {{baseUrl}}/empresas/1/vendas
Content-Type: application/json

{
  "identificacao": "VENDA-EMPRESA-002",
  "clienteId": 3,
  "funcionarioId": 1,
  "veiculoId": 1,
  "servicos": [
    { "servicoId": 2 }
  ]
}

###

# CRIAR VENDA SEM ITENS (422 — regra de negócio)
POST {{baseUrl}}/empresas/1/vendas
Content-Type: application/json

{
  "identificacao": "VENDA-EMPRESA-003",
  "clienteId": 3,
  "funcionarioId": 1,
  "itens": [],
  "servicos": []
}

###

