# =========================
# CASOS DE SEGURANÇA / EDGE
# =========================

# CRIAR EMPRESA COM SQL INJECTION
POST {{baseUrl}}/empresas
Content-Type: application/json

{
  "razaoSocial": "'; DROP TABLE empresa; --",
  "nomeFantasia": "Hacker LTDA"
}

###

# CRIAR EMPRESA COM XSS
POST {{baseUrl}}/empresas
Content-Type: application/json

{
  "razaoSocial": "<script>alert('xss')</script>",
  "nomeFantasia": "XSS LTDA"
}
