###

# ASSOCIAR MERCADORIA EXISTENTE A EMPRESA (200)
POST {{baseUrl}}/empresas/1/mercadorias/1

###

# ASSOCIAR MERCADORIA INEXISTENTE (404)
POST {{baseUrl}}/empresas/1/mercadorias/999999

###

# ASSOCIAR MERCADORIA EM EMPRESA INEXISTENTE (404)
POST {{baseUrl}}/empresas/999999/mercadorias/1

###

# DESASSOCIAR MERCADORIA EM USO POR VENDA (409 — mercadoria 1 está na venda 1)
DELETE {{baseUrl}}/empresas/1/mercadorias/1

###

# DESASSOCIAR MERCADORIA QUE NAO EXISTE (404)
DELETE {{baseUrl}}/empresas/1/mercadorias/999999

###

# DESASSOCIAR MERCADORIA QUE NAO PERTENCE A EMPRESA (404)
# (Criar uma mercadoria órfã primeiro com POST, depois tentar desassociar de outra empresa)
DELETE {{baseUrl}}/empresas/2/mercadorias/1

###


# =========================
# SUB-RECURSO: SERVIÇOS
