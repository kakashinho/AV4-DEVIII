{
  "nome": "Errada",
  "valor": -10.0,
  "validade": "2027-12-31",
  "fabricacao": "2025-01-15",
  "quantidade": 1
}

###

# CRIAR MERCADORIA COM QUANTIDADE NEGATIVA (400)
POST {{baseUrl}}/empresas/1/mercadorias
Content-Type: application/json

{
  "nome": "Errada",
  "valor": 10.0,
  "validade": "2027-12-31",
  "fabricacao": "2025-01-15",
  "quantidade": -1
}

###

# CRIAR MERCADORIA COM VALIDADE PASSADA (400)
POST {{baseUrl}}/empresas/1/mercadorias
Content-Type: application/json

{
  "nome": "Vencida",
  "valor": 10.0,
  "validade": "2020-01-01",
  "fabricacao": "2019-01-01",
  "quantidade": 1
}

###

# CRIAR MERCADORIA COM FABRICACAO FUTURA (400)
POST {{baseUrl}}/empresas/1/mercadorias
Content-Type: application/json

{
  "nome": "Futura",
  "valor": 10.0,
  "validade": "2030-01-01",
  "fabricacao": "2099-01-01",
  "quantidade": 1
}

###

# CRIAR MERCADORIA EM EMPRESA INEXISTENTE (404)
POST {{baseUrl}}/empresas/999999/mercadorias
Content-Type: application/json

{
  "nome": "Item",
  "valor": 10.0,
  "validade": "2027-12-31",
  "fabricacao": "2025-01-15",
  "quantidade": 5
