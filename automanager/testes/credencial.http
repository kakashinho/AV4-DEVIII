  "senha": "senha_extremamente_grande_para_testar_limites_do_sistema_e_validacoes_de_tamanho_123456789",
  "codigo": null
}

###

# CRIAR CREDENCIAL COM SQL INJECTION
POST {{baseUrl}}/credenciais
Content-Type: application/json

{
  "inativo": false,
  "nomeUsuario": "' OR '1'='1",
  "senha": "' OR '1'='1",
  "codigo": null
}

###

# CRIAR CREDENCIAL COM XSS
POST {{baseUrl}}/credenciais
Content-Type: application/json

{
  "inativo": false,
  "nomeUsuario": "<script>alert('xss')</script>",
  "senha": "<script>alert('xss')</script>",
  "codigo": null
}

###

