  "inativo": false,
  "nomeUsuario": "admin",
  "senha": "123456",
  "codigo": 10,
}

###

# CRIAR CREDENCIAL COM CONTENT TYPE INVALIDO
POST {{baseUrl}}/credenciais
Content-Type: text/plain

{
  "inativo": false,
  "nomeUsuario": "admin",
  "senha": "123456",
  "codigo": 10
}

###

# CRIAR CREDENCIAL COM CAMPOS EXTRAS
POST {{baseUrl}}/credenciais
Content-Type: application/json

{
  "inativo": false,
  "nomeUsuario": "admin",
  "senha": "123456",
  "codigo": 10,
  "extra": "campo-extra"
}

###

# CRIAR CREDENCIAL COM NOME USUARIO MUITO GRANDE
POST {{baseUrl}}/credenciais
Content-Type: application/json

{
  "inativo": false,
  "nomeUsuario": "usuario_com_nome_extremamente_grande_para_testar_limites_do_sistema_e_validacoes_de_tamanho",
  "senha": "123456",
  "codigo": null
}

###

# CRIAR CREDENCIAL COM SENHA MUITO GRANDE
