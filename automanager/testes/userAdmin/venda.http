# =========================
# PAYLOADS MALFORMADOS
# =========================

# JSON INVÁLIDO (vírgula sobrando)
POST {{baseUrl}}/vendas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "identificacao": "VENDA-014",
  "clienteId": 3,
  "funcionarioId": 1,
  "itens": [
    { "mercadoriaId": 2, "quantidade": 1 }
  ],
}

###

# BODY VAZIO
POST {{baseUrl}}/vendas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{}

###

# CONTENT-TYPE ERRADO
POST {{baseUrl}}/vendas
Content-Type: text/plain

{
  "identificacao": "VENDA-015"
}

###

# =========================
# ATUALIZAÇÃO
# =========================

# ATUALIZAR OK
PUT {{baseUrl}}/vendas/1
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "identificacao": "VENDA-001-UPDATE",
  "clienteId": 3,
  "funcionarioId": 1,
  "veiculoId": 1,
  "empresaId": 1,
  "itens": [
    { "mercadoriaId": 2, "quantidade": 1 }
  ],
  "servicos": [
    { "servicoId": 1 }
  ]
}

###

# ATUALIZAR SEM IDENTIFICAÇÃO
PUT {{baseUrl}}/vendas/1
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "clienteId": 3,
  "funcionarioId": 1
}

###

# ATUALIZAR SEM BODY
PUT {{baseUrl}}/vendas/1
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{}

###

# ATUALIZAR ID INVÁLIDO
PUT {{baseUrl}}/vendas/abc
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "identificacao": "TESTE"
}

###

# =========================
# DELETE
# =========================

# DELETE OK
DELETE {{baseUrl}}/vendas/1
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# DELETE INEXISTENTE
DELETE {{baseUrl}}/vendas/999999
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# DELETE ID INVÁLIDO
DELETE {{baseUrl}}/vendas/abc
Authorization: Bearer {{loginAdmin.response.body.token}}

###
