@baseUrl = http://localhost:8080/api

### Login ADMIN
# @name loginAdmin
POST  http://localhost:8080/auth/login
Content-Type: application/json

{ "nomeUsuario": "admin", "senha": "123456" }

# =========================================
# VENDAS - TESTES COMPLETOS (CRUD + ERROS)
# =========================================

# LISTAR VENDAS
GET {{baseUrl}}/vendas
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# BUSCAR VENDA OK
GET {{baseUrl}}/vendas/1
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# BUSCAR VENDA INEXISTENTE
GET {{baseUrl}}/vendas/999999
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# BUSCAR VENDA ID INVÁLIDO (STRING)
GET {{baseUrl}}/vendas/abc
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# BUSCAR VENDA ID ZERO
GET {{baseUrl}}/vendas/0
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# BUSCAR VENDA ID NEGATIVO
GET {{baseUrl}}/vendas/-1
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# =========================
# CRIAÇÃO - CASOS VÁLIDOS
# =========================

# CRIAR VENDA COMPLETA (mercadoria + serviço)
POST {{baseUrl}}/vendas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "identificacao": "VENDA-001",
  "clienteId": 3,
  "funcionarioId": 1,
  "veiculoId": 1,
  "empresaId": 1,
  "itens": [
    { "mercadoriaId": 2, "quantidade": 1 }
  ],
  "servicos": [
    { "servicoId": 1 }
  ]
}

###

# CRIAR VENDA SOMENTE COM MERCADORIA
POST {{baseUrl}}/vendas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "identificacao": "VENDA-002",
  "clienteId": 3,
  "funcionarioId": 1,
  "empresaId": 1,
  "itens": [
    { "mercadoriaId": 2, "quantidade": 1 }
  ]
}

###

# CRIAR VENDA SOMENTE COM SERVIÇO
POST {{baseUrl}}/vendas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "identificacao": "VENDA-003",
  "clienteId": 3,
  "funcionarioId": 1,
  "empresaId": 1,
  "servicos": [
    { "servicoId": 1 }
  ]
}

###

# CRIAR VENDA SEM VEÍCULO (válido)
POST {{baseUrl}}/vendas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "identificacao": "VENDA-004",
  "clienteId": 3,
  "funcionarioId": 1,
  "empresaId": 1,
  "itens": [
    { "mercadoriaId": 2, "quantidade": 1 }
  ]
}

###

# =========================
# ERROS DE VALIDAÇÃO
# =========================

# IDENTIFICAÇÃO VAZIA
POST {{baseUrl}}/vendas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "identificacao": "",
  "clienteId": 3,
  "funcionarioId": 1,
  "empresaId": 1,
  "itens": [
    { "mercadoriaId": 2, "quantidade": 1 }
  ]
}

###

# IDENTIFICAÇÃO NULA
POST {{baseUrl}}/vendas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "clienteId": 3,
  "funcionarioId": 1,
  "empresaId": 1
}

###

# SEM CLIENTE
POST {{baseUrl}}/vendas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "identificacao": "VENDA-005",
  "funcionarioId": 1,
  "empresaId": 1,
  "itens": [
    { "mercadoriaId": 2, "quantidade": 1 }
  ]
}

###

# SEM FUNCIONÁRIO
POST {{baseUrl}}/vendas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "identificacao": "VENDA-006",
  "clienteId": 3,
  "empresaId": 1,
  "itens": [
    { "mercadoriaId": 2, "quantidade": 1 }
  ]
}

###

# SEM ITENS (REGRA NEGÓCIO — deve retornar 422)
POST {{baseUrl}}/vendas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "identificacao": "VENDA-007",
  "clienteId": 3,
  "funcionarioId": 1,
  "empresaId": 1,
  "itens": [],
  "servicos": []
}

###

# CLIENTE = FUNCIONÁRIO (REGRA NEGÓCIO — deve retornar 422)
POST {{baseUrl}}/vendas
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "identificacao": "VENDA-008",
  "clienteId": 1,
  "funcionarioId": 1,
  "empresaId": 1,
  "servicos": [
    { "servicoId": 1 }
  ]
}

###

