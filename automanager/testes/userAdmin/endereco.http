###

# CRIAR ENDERECO COM SQL INJECTION
POST {{baseUrl}}/enderecos
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "estado": "' OR '1'='1",
  "cidade": "São Paulo",
  "bairro": "Centro",
  "rua": "Rua A",
  "numero": "10",
  "codigoPostal": "01000000"
}

###

# CRIAR ENDERECO COM XSS
POST {{baseUrl}}/enderecos
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "estado": "<script>alert('xss')</script>",
  "cidade": "São Paulo",
  "bairro": "Centro",
  "rua": "Rua A",
  "numero": "10",
  "codigoPostal": "01000000"
}

###

