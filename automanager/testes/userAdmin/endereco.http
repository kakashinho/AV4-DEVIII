@baseUrl = http://localhost:8080/api

### Login ADMIN
# @name loginAdmin
POST  http://localhost:8080/auth/login
Content-Type: application/json

{ "nomeUsuario": "admin", "senha": "123456" }

# ENDERECOS

###
# LISTAR ENDERECOS OK
GET {{baseUrl}}/enderecos
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# BUSCAR ENDERECO EXISTENTE OK
GET {{baseUrl}}/enderecos/1
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# BUSCAR ENDERECO INEXISTENTE OK
GET {{baseUrl}}/enderecos/999999
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# BUSCAR ENDERECO COM ID INVALIDO
GET {{baseUrl}}/enderecos/abc
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# BUSCAR ENDERECO COM ID NEGATIVO
GET {{baseUrl}}/enderecos/-1
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# BUSCAR ENDERECO COM ID ZERO
GET {{baseUrl}}/enderecos/0
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# CRIAR ENDERECO VALIDO OK
POST {{baseUrl}}/enderecos
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "estado": "SP",
  "cidade": "São José dos Campos",
  "bairro": "Centro",
  "rua": "Rua das Flores",
  "numero": "123",
  "codigoPostal": "12210000",
  "informacoesAdicionais": "Apartamento 12"
}

