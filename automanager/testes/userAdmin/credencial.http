###

# CRIAR CREDENCIAL COM SQL INJECTION
POST {{baseUrl}}/credenciais
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "inativo": false,
  "nomeUsuario": "' OR '1'='1",
  "senha": "' OR '1'='1",
  "codigo": null
}

###

# CRIAR CREDENCIAL COM XSS
POST {{baseUrl}}/credenciais
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "inativo": false,
  "nomeUsuario": "<script>alert('xss')</script>",
  "senha": "<script>alert('xss')</script>",
  "codigo": null
}

