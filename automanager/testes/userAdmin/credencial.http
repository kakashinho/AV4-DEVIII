@baseUrl = http://localhost:8080/api

### Login ADMIN
# @name loginAdmin
POST  http://localhost:8080/auth/login
Content-Type: application/json

{ "nomeUsuario": "admin", "senha": "123456" }

# CREDENCIAIS

###
# LISTAR CREDENCIAIS OK
GET {{baseUrl}}/credenciais
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# BUSCAR CREDENCIAL EXISTENTE OK
GET {{baseUrl}}/credenciais/1
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# BUSCAR CREDENCIAL INEXISTENTE OK
GET {{baseUrl}}/credenciais/999999
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# BUSCAR CREDENCIAL COM ID INVALIDO
GET {{baseUrl}}/credenciais/abc
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# BUSCAR CREDENCIAL COM ID NEGATIVO
GET {{baseUrl}}/credenciais/-1
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# BUSCAR CREDENCIAL COM ID ZERO
GET {{baseUrl}}/credenciais/0
Authorization: Bearer {{loginAdmin.response.body.token}}

###

# CRIAR CREDENCIAL VALIDA
POST {{baseUrl}}/credenciais
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "inativo": false,
  "nomeUsuario": "superAdmin",
  "senha": "123456"
}

###

# CRIAR CREDENCIAL INATIVA
POST {{baseUrl}}/credenciais
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.token}}

{
  "inativo": true,
  "codigo": 200000
}

###

# CRIAR CREDENCIAL SEM INATIVO
POST {{baseUrl}}/credenciais
