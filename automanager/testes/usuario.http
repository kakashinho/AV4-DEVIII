### Variável base
@baseUrl = http://localhost:8080/api/usuarios
@usuarioId = 1

###

# =========================
# LISTAR USUÁRIOS
# =========================
GET {{baseUrl}}
Accept: application/json

###

# =========================
# BUSCAR USUÁRIO POR ID
# =========================
GET {{baseUrl}}/1
Accept: application/json

###

# =========================
# CRIAR USUÁRIO (CASO VÁLIDO MÍNIMO)
# =========================
POST {{baseUrl}}
Content-Type: application/json

{
  "nome": "João Silva",
  "nomeSocial": "João",
  "perfis": ["CLIENTE"],
  "endereco": {
    "estado": "SP",
    "cidade": "São José dos Campos",
    "bairro": "Centro",
    "rua": "Rua A",
    "numero": "100",
    "codigoPostal": "12209000",
    "informacoesAdicionais": "Apto 12"
  }
}

###

# =========================
# CRIAR USUÁRIO (SEM PERFIL → ERRO ESPERADO) OK
# =========================
