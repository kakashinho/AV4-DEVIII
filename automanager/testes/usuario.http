###

# =========================
# ATUALIZAR USUÁRIO
# =========================
PUT {{baseUrl}}/{{usuarioId}}
Content-Type: application/json

{
  "nome": "Nome Atualizado",
  "nomeSocial": "Atualizado",
  "perfis": ["CLIENTE"],
  "endereco": {
    "estado": "SP",
    "cidade": "Atualizada",
    "bairro": "Centro",
    "rua": "Rua Atual",
    "numero": "999",
    "codigoPostal": "99999999"
  }
}

###

# =========================
# REMOVER USUÁRIO
# =========================
DELETE {{baseUrl}}/{{usuarioId}}

